# Copy to .env and fill in.

# SQLite file for local dev. Swap the provider in prisma/schema.prisma for Postgres in prod.
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Public URL of the app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring price ID of your "Pro" product
STRIPE_PRICE_ID="price_..."
