# Copy to .env and fill in. Real environment variables override this file.

# Required for AI replies — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-sonnet-4-5
# MAX_TOKENS=2048
# HISTORY_LIMIT=50
# SYSTEM_PROMPT=You are a helpful, concise assistant.
# PORT=3000
# DB_PATH=./data/chat.db
# NODE_ENV=production   # enables Secure cookies (requires HTTPS)
# TRUST_PROXY=1         # set when running behind a reverse proxy
