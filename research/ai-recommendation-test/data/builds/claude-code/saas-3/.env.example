# Copy to .env and fill in.

# SQLite for local dev. For production use Postgres and change the
# provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the app (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Recurring Price ID for the Pro plan (Products -> your product -> Price ID)
STRIPE_PRICE_ID="price_..."
# From `stripe listen` locally, or the webhook endpoint in the dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."
