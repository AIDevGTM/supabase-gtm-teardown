# Copy to .env and fill in.

# SQLite for local dev. For production use Postgres and change the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Used to sign session cookies. Must be 32+ chars. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Recurring price ID for the Pro plan (Products -> your product -> Pricing)
STRIPE_PRICE_ID="price_..."
# From `stripe listen` output locally, or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET="whsec_..."
